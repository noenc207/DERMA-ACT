# DERMA-ACT V2 Clean-Room Environment Template (Safe Placeholders Only)
# Copy to .env locally if overriding defaults; never commit .env or live secrets.

# Override repository/data root for Tier A or mounted Tier B reproduction scripts
DERMA_ACT_ROOT=.

# Inference/evaluation runtime settings (research-only; no web API or external database required)
DERMA_ACT_DEVICE=cpu
DERMA_ACT_LOG_LEVEL=INFO
PYTHONDONTWRITEBYTECODE=1

# Optional external dataset directory if running Tier B scripts outside DERMA_ACT_ROOT
# ISIC2019_DATA_DIR=./data/isic2019
